# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=enjoy_pakistan_tour
DB_USER=root
DB_PASSWORD=your_mysql_password

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Seed admin (used only by `npm run seed`)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@enjoypakistantour.com
ADMIN_PASSWORD=Admin@12345

# Default WhatsApp number (E.164 format, no + sign, e.g. 923001234567)
DEFAULT_WHATSAPP_NUMBER=923001234567
