modules = ["nodejs-24"]

[userenv]

[userenv.shared]
CLIENT_URL = "http://localhost:5173"
DEFAULT_WHATSAPP_NUMBER = "923001234567"
JWT_EXPIRES_IN = "7d"
NODE_ENV = "production"
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node src/server.js"
waitForPort = 5000

[deployment]
deploymentTarget = "autoscale"
run = ["node", "src/server.js"]
